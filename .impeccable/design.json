  "narrative": {
    "northStar": "The Dispatcher's Desk",
    "overview": "A calm, precise planning console for one person deciding where and when a 26-ft truck should drive. The chrome is deliberately quiet: sage-tinted paper, white panels, hairline borders, small system type, tabular numbers. All the loudness is saved for the weather and the risk. When something on screen is red, violet or orange, it carries meaning: gusts near the closure line, snow at a pass, rain near freezing.\n\nThe map and the profile chart under it do the work. The 372px sidebar is a dispatcher's clipboard. It holds the route cards, the toggles, a ranked watch list, the itinerary with weather at each stop, and an honest account of which forecast sources answered. Density is high but never cramped: 12–14px text, 6–8px gaps, 20px gutters.\n\nUncertainty is shown, not hidden. Estimated stop times get an amber \"est\" tag. Approximate route lines get a warning note. The faint bars, the opacity that tracks how many sources agree, and the shaded temperature spread show where the sources disagree.",
    "keyCharacteristics": [
      "Quiet neutral chrome; color reserved for weather encodings, risk and route identity.",
      "System sans throughout, tabular numerals for every time, temperature and speed.",
      "Flat surfaces with hairline borders; soft shadows only on things floating over the map.",
      "Small, uppercase, letter-spaced section labels; no large headings.",
      "Every hazard encoding is paired with a number or label, never color alone."
    ],
    "rules": [
      { "name": "The Weather Owns Color Rule", "body": "Hue on screen means weather, risk, or which route. Chrome stays neutral. Blue never decorates, because blue means rain.", "section": "colors" },
      { "name": "The Paired Encoding Rule", "body": "Every color-coded value also shows a number, label or shape (mph value, \"est\" tag, S/H/F/★/▲ marker), so nothing depends on hue alone.", "section": "colors" },
      { "name": "The Tabular Numbers Rule", "body": "Times, temperatures, speeds, mileages and tables always use tabular numerals, so columns line up when values change.", "section": "typography" },
      { "name": "The No Big Type Rule", "body": "The largest type is 19px. Hierarchy comes from weight, case and ink level, not size.", "section": "typography" },
      { "name": "The Float-Only Shadow Rule", "body": "A shadow means \"this is above the map or page.\" Panels and cards that sit in the layout never get one. The focused route card uses a 1px inset ring in its route color instead of lift.", "section": "elevation" }
    ],
    "dos": [
      "Do keep chrome neutral (ink, hairline, sage paper) and let weather, risk and route colors carry all hue.",
      "Do use tabular numerals for every number that can change.",
      "Do pair every color encoding with a value, label or glyph.",
      "Do mark estimates and approximations visibly (amber \"est\" tag, warning note), never silently.",
      "Do reserve shadows for elements floating over the map or page.",
      "Do keep the 40 mph and 32°F reference lines; they are the decision thresholds."
    ],
    "donts": [
      "Don't use rain blue, snow violet or the wind reds for decoration, buttons or branding.",
      "Don't add type larger than the 19px title, or display fonts.",
      "Don't add shadows to in-layout cards or panels; use the inset route-color ring for selection.",
      "Don't reuse Dispatch Teal on anything that could read as Route 3's line."
    ]
  }
}
