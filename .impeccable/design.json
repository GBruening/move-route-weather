    {
      "name": "Route Card",
      "kind": "card",
      "refersTo": "route-card",
      "description": "Selectable route summary with a route-colored left bar and stat chips.",
      "html": "<button class=\"ds-route is-focus\" style=\"--rc:#475569\"><span class=\"ds-route-bar\"></span><span><span class=\"ds-route-name\"><b>Route 1</b> <span>I-80</span> <span class=\"ds-badge\">Current plan</span></span><span class=\"ds-route-meta\">3 days · 1,312 mi · nights Rock Springs, Baker City</span><span class=\"ds-route-stats\"><span class=\"ds-stat bad\">gust 47 mph</span><span class=\"ds-stat snow\">snow 2 cm</span><span class=\"ds-stat\">low 24°</span></span></span></button>",
      "css": ".ds-route{display:grid;grid-template-columns:6px 1fr;gap:0 12px;border:1px solid var(--line,#e2e5e1);border-radius:10px;padding:10px 10px 10px 0;background:#fff;cursor:pointer;text-align:left;width:340px;font:14px/1.45 ui-sans-serif,-apple-system,'Segoe UI',Roboto,sans-serif;color:#18212b;transition:border-color .15s,box-shadow .15s}.ds-route:hover{border-color:#cfd4cf}.ds-route.is-focus{border-color:var(--rc);box-shadow:0 0 0 1px var(--rc) inset}.ds-route:focus-visible{outline:2px solid #0f766e;outline-offset:2px}.ds-route-bar{background:var(--rc);border-radius:0 4px 4px 0}.ds-route-name{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}.ds-route-name span{color:#4a5662;font-size:13px}.ds-route-meta{display:block;color:#7b8692;font-size:12px;margin-top:2px}.ds-route-stats{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.ds-badge{font-size:10.5px;font-weight:650;padding:1px 6px;border-radius:99px;background:#e6f4f1;color:#0f5f58!important}.ds-stat{font-size:11.5px;padding:1px 7px;border-radius:6px;background:#eef0ec;color:#4a5662;font-variant-numeric:tabular-nums}.ds-stat.bad{background:#fde2e2;color:#991b1b}.ds-stat.snow{background:#efe7fe;color:#5b21b6}"
    },
    {
      "name": "Stat Chips",
      "kind": "chip",
      "refersTo": "stat-chip",
      "description": "Tabular value chips; tinted only when a threshold is crossed.",
      "html": "<div class=\"ds-chips\"><span class=\"ds-stat\">low 24°</span><span class=\"ds-stat warn\">gust 36 mph</span><span class=\"ds-stat bad\">gust 47 mph</span><span class=\"ds-stat rain\">rain 6 mm</span><span class=\"ds-stat snow\">snow 2 cm</span><span class=\"ds-est\">est</span></div>",
      "css": ".ds-chips{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-family:ui-sans-serif,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-stat{font-size:11.5px;padding:1px 7px;border-radius:6px;background:#eef0ec;color:#4a5662;font-variant-numeric:tabular-nums}.ds-stat.warn{background:#fdecdf;color:#9a3412}.ds-stat.bad{background:#fde2e2;color:#991b1b}.ds-stat.rain{background:#e3edfd;color:#1e40af}.ds-stat.snow{background:#efe7fe;color:#5b21b6}.ds-est{font-size:10.5px;font-weight:650;color:#92400e;background:#fef3c7;padding:0 5px;border-radius:4px}"
    },
    {
      "name": "Switch",
