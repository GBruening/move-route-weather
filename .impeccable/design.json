      "name": "Watch List Item",
      "kind": "custom",
      "refersTo": "watch-item",
      "description": "Ranked hazard row with a severity dot; click focuses the map.",
      "html": "<ul class=\"ds-watch\"><li class=\"high\"><span class=\"dot\"></span><span>Worst gust 47 mph near Arlington<small>Sat 4:10 PM MST · 4 of 4 sources</small></span></li><li class=\"low\"><span class=\"dot\"></span><span>Rain near freezing at Snoqualmie<small>Mon 11:40 AM PST · 34°F</small></span></li></ul>",
      "css": ".ds-watch{list-style:none;margin:0;padding:0;display:grid;gap:6px;width:330px;font-family:ui-sans-serif,-apple-system,'Segoe UI',Roboto,sans-serif;color:#18212b}.ds-watch li{display:grid;grid-template-columns:8px 1fr;gap:10px;padding:8px 10px;border-radius:8px;background:#f7f8f6;cursor:pointer;font-size:13px}.ds-watch li:hover{background:#eff1ed}.ds-watch .dot{width:8px;height:8px;border-radius:50%;margin-top:6px;background:#7b8692}.ds-watch li.high .dot{background:#b91c1c}.ds-watch li.med .dot{background:#ea580c}.ds-watch li.low .dot{background:#ca8a04}.ds-watch small{display:block;color:#7b8692;font-size:12px}"
    },
    {
      "name": "Icon Button (eye)",
